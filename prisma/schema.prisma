generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// This model represents recruiter
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes    Resume[]
  candidates Candidate[]
  jobs       Job[]
}

model Resume {
  id       String @id @default(cuid())
  fileName String
  fileUrl  String
  fileSize Int

  candidate Candidate? // represents the extracted candidate information from this resume

  status       ResumeStatus @default(PENDING)
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedById String // id of recruiter who uploaded this resume
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

enum ResumeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// This model represents extracted candidate information from the resume
model Candidate {
  id       String  @id @default(cuid())
  name     String?
  email    String?
  phone    String?
  location String?
  linkedIn String?

  skills           String[]                 @default([])
  normalizedSkills String[]                 @default([])
  skillEvidence    CandidateSkillEvidence[]
  projects         Project[]
  experience       Experience[]
  education        Education[]

  candidatePointEmbeddings CandidatePointEmbedding[] // Stores embeddings of individual Experience and Project points for semantic matching

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedById String // id of recruiter who uploaded this candidate's resume
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  resumeId         String           @unique
  resume           Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  candidateMatches CandidateMatch[]

  @@index([uploadedById])
}

model CandidateSkillEvidence {
  id String @id @default(cuid())

  skill           String
  normalizedSkill String

  source       SkillEvidenceSource
  evidenceType SkillEvidenceType

  sourceTitle String? // eg. Project title (if the skill is found/inferred in/from project)
  evidence    String? // eg. Project describes building reusable UI components(evidence for react.js in case of evidence type as inferred)
  companyName String? // Used if the evidence is from experience

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

enum SkillEvidenceType {
  LISTED
  EXPLICIT
  INFERRED
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  position    String
  description String?  @db.Text
  points      String[] @default([]) // contains individual points of the description(for semantic matching with job responsibilities using embeddings)
  startDate   String?
  endDate     String?

  pointEmbeddings CandidatePointEmbedding[] // Embeddings generated from the individual experience points

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  points       String[] @default([]) // contains individual points of the description(for semantic matching with job responsibilities using embeddings)
  technologies String[] @default([])
  projectUrl   String?

  pointEmbeddings CandidatePointEmbedding[] // Embeddings generated from the individual project points

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Education {
  id             String         @id @default(cuid())
  educationLevel EducationLevel
  institution    String?
  degree         String?
  fieldOfStudy   String?
  startYear      String?
  endYear        String?
  gradeType      GradeType?
  grade          Float?

  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  matchedFor  EducationMatch[]
}

enum EducationLevel {
  SECONDARY
  HIGHER_SECONDARY
  DIPLOMA
  ASSOCIATE
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  OTHER
}

enum GradeType {
  PERCENTAGE
  CGPA
}

model Job {
  id            String  @id @default(cuid())
  title         String
  description   String  @db.Text
  minExperience Int?
  maxExperience Int?
  location      String?

  skillGroups          SkillGroup[]
  educationRequirement EducationRequirement?
  JobResponsibilities  jobResponsibility[]

  status           JobStatus           @default(DRAFT)
  extractionStatus JobExtractionStatus @default(PENDING)
  extractionError  String?

  lastEvaluatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById      String
  createdBy        User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  candidateMatches CandidateMatch[]

  @@index([createdById])
}

// This model represents a group of skills for a job, which can have multiple skill requirements
model SkillGroup {
  id       String @id @default(cuid())
  category String // e.g., "Programming Languages", "Frameworks", "Tools"

  requirementType SkillGroupType @default(ANY) // whether all skill are required (ALL), any one is required (REQUIRED), or none are required but preferred (PREFERRED)

  skills SkillRequirement[] // skills that belong to this group

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// This model represents a skill requirement for a job, which belongs to a skill group
model SkillRequirement {
  id             String @id @default(cuid())
  name           String
  normalizedName String

  groupId String
  group   SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, normalizedName])
  @@index([normalizedName])
}

// This model represents the education requirement for a job
model EducationRequirement {
  id                String          @id @default(cuid())
  minEducationLevel EducationLevel?

  acceptedDegrees       AcceptedDegree[]
  relatedDegreesAllowed Boolean          @default(false) // whether related degrees are allowed or not
  isMandatory           Boolean          @default(true) // whether any of the accepted degrees is mandatory or not

  // Only used if JD has related degrees allowed in specfic field of study
  relatedDegreeFieldsOfStudy           String[] @default([]) // for related degrees
  normalizedRelatedDegreeFieldsOfStudy String[] @default([])

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// This model represents the accepted degree for a job's education requirement
model AcceptedDegree {
  id                   String @id @default(cuid())
  degreeName           String
  normalizedDegreeName String

  acceptedFieldOfStudy           String[] @default([]) // accepted field of study for this degree, if any
  normalizedAcceptedFieldOfStudy String[] @default([])
  isFieldOfStudyMandatory        Boolean  @default(false) // whether any of the accepted field of study is mandatory or not

  educationRequirementId String
  educationRequirement   EducationRequirement @relation(fields: [educationRequirementId], references: [id], onDelete: Cascade)

  @@unique([educationRequirementId, normalizedDegreeName])
  @@index([normalizedDegreeName])
}

model jobResponsibility {
  id             String  @id @default(cuid())
  responsibility String // individual responsibility
  embedding      Float[] // Vector embedding of the responsibility used for semantic matching with candidate points
  weight         Int // weight/importance of this responsibility based on its relevance and importance to the job

  jobId                 String
  job                   Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  responsibilityMatches ResponsibilityMatch[]
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum JobExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SkillGroupType {
  ANY
  ALL
  PREFERRED // this group is preferred but not mandatory, i.e., if the candidate has skills from this group, it will be a plus point, but not having them will not disqualify the candidate
}

// This model represents the embedding of a candidate's individual point (either from Experience or Project) for semantic matching with job responsibilities
model CandidatePointEmbedding {
  id        String  @id @default(cuid())
  content   String  @db.Text // The content of the point (either from Experience or Project) that is being embedded
  embedding Float[] // Vector representation of the candidate point generated by the embedding model

  candidateId  String
  experienceId String?
  projectId    String?

  candidate               Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  experience              Experience?              @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  project                 Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsibilityEvidences ResponsibilityEvidence[]

  @@index([candidateId])
}

model CandidateMatch {
  id String @id @default(cuid())

  overallScore        Float?
  skillScore          Float?
  educationScore      Float?
  experienceScore     Float?
  responsibilityScore Float?

  skillGroups           SkillGroupMatch[]
  educationEvaluation   EducationMatch?
  experienceEvaluation  ExperienceMatch?
  responsibilityMatches ResponsibilityMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId, overallScore(sort: Desc)])
  @@index([candidateId])
}

model SkillGroupMatch {
  id String @id @default(cuid())

  category        String // e.g., "Programming Languages", "Frameworks", "Tools"
  requirementType SkillGroupType

  score Float

  totalCount        Int // Total no. of skills in this group
  matchedCount      Int // Total no. of skills candidate matched
  demonstratedCount Int
  listedCount       Int
  missingCount      Int

  skillResults SkillRequirementMatch[]

  createdAt DateTime @default(now())

  matchId String
  match   CandidateMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model SkillRequirementMatch {
  id String @id @default(cuid())

  // Snapshot of the required skill
  name           String
  normalizedName String

  // status         SkillMatchStatus
  evidenceType   SkillEvidenceType? // Optional for missing case
  evidenceSource SkillEvidenceSource @default(NONE)

  evidenceTitle String? // eg. Project title (if the skill is found/inferred in/from project) or position
  evidence      String? // eg. Project describes building reusable UI components(evidence for react.js in case of evidence type as inferred)
  companyName   String? // Used if the evidence is from experience

  // 0–1 credit assigned to this skill
  credit Float

  // evidenceTitle String? // Project/Position title

  createdAt DateTime @default(now())

  groupMatchId String
  groupMatch   SkillGroupMatch @relation(fields: [groupMatchId], references: [id], onDelete: Cascade)

  @@index([groupMatchId])
}

enum SkillEvidenceSource {
  SKILLS_SECTION
  PROJECT
  WORK_EXPERIENCE
  NONE
}

model EducationMatch {
  id String @id @default(cuid())

  matchId String         @unique
  match   CandidateMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  score Float

  // Overall results
  meetsMinimumLevel     Boolean?
  acceptedDegreeMatched Boolean?
  fieldOfStudyMatched   Boolean?
  relatedDegreeUsed     Boolean  @default(false)

  // Which education record provided the best match?
  matchedEducationRecordId String?
  matchedEducation         Education? @relation(fields: [matchedEducationRecordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExperienceMatch {
  id String @id @default(cuid())

  score Float

  totalWorkExperience Float

  meetsMinimumExperience Boolean?
  meetsMaximumExperience Boolean?

  matchId String         @unique
  match   CandidateMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResponsibilityMatch {
  id String @id @default(cuid())

  // Snapshot of the job responsibility
  responsibilityText String @db.Text
  weight             Int

  // Evaluation results
  score          Float
  bestSimilarity Float?
  matchLevel     ResponsibilityMatchLevel

  matchedEvidenceCount Int @default(0)

  evidence ResponsibilityEvidence[]

  createdAt DateTime @default(now())

  matchId String
  match   CandidateMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  jobResponsibilityId String?
  jobResponsibility   jobResponsibility? @relation(fields: [jobResponsibilityId], references: [id], onDelete: SetNull)

  @@index([matchId])
}

model ResponsibilityEvidence {
  id String @id @default(cuid())

  // Snapshot of the evidence
  evidenceText String                       @db.Text
  sourceType   ResponsibilityEvidenceSource
  sourceTitle  String? // eg: Project: E-commerce Backend, Experience: Backend Developer at XYZ

  // Similarity between this evidence and the job responsibility
  similarityScore Float

  // Whether this was the strongest supporting evidence
  isPrimary Boolean @default(false)

  // explanation String? @db.Text

  createdAt DateTime @default(now())

  responsibilityMatchId String
  responsibilityMatch   ResponsibilityMatch @relation(fields: [responsibilityMatchId], references: [id], onDelete: Cascade)

  // Link to the original candidate point embedding
  pointEmbeddingId String?
  pointEmbedding   CandidatePointEmbedding? @relation(fields: [pointEmbeddingId], references: [id], onDelete: SetNull)

  @@index([responsibilityMatchId])
  @@index([pointEmbeddingId])
}

enum ResponsibilityMatchLevel {
  STRONG
  PARTIAL
  WEAK
  NONE
}

enum ResponsibilityEvidenceSource {
  PROJECT
  EXPERIENCE
}
