generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// This model represents recruiter
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes    Resume[]
  candidates Candidate[]
  jobs       Job[]
}

model Resume {
  id       String @id @default(cuid())
  fileName String
  fileUrl  String
  fileSize Int

  candidate Candidate? // represents the extracted candidate information from this resume

  status       ResumeStatus @default(PENDING)
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedById String // id of recruiter who uploaded this resume
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

enum ResumeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// This model represents extracted candidate information from the resume
model Candidate {
  id       String  @id @default(cuid())
  name     String?
  email    String?
  phone    String?
  location String?
  linkedIn String?

  skills           String[]     @default([])
  normalizedSkills String[]     @default([])
  projects         Project[]
  experience       Experience[]
  education        Education[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedById String // id of recruiter who uploaded this candidate's resume
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([uploadedById])
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  position    String
  description String?  @db.Text
  points      String[] @default([]) // contains individual points of the description(for semantic matching with job responsibilities using embeddings)
  startDate   String?
  endDate     String?

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  points       String[] @default([]) // contains individual points of the description(for semantic matching with job responsibilities using embeddings)
  technologies String[] @default([])
  projectUrl   String?

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Education {
  id             String         @id @default(cuid())
  educationLevel EducationLevel
  institution    String?
  degree         String?
  fieldOfStudy   String?
  startYear      String?
  endYear        String?
  gradeType      GradeType?
  grade          Float?

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

enum EducationLevel {
  SECONDARY
  HIGHER_SECONDARY
  DIPLOMA
  ASSOCIATE
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  OTHER
}

enum GradeType {
  PERCENTAGE
  CGPA
}

model Job {
  id            String  @id @default(cuid())
  title         String
  description   String  @db.Text
  minExperience Int?
  maxExperience Int?
  location      String?

  skillGroups          SkillGroup[]
  educationRequirement EducationRequirement?
  JobResponsibilities  jobResponsibility[]

  status           JobStatus           @default(DRAFT)
  extractionStatus JobExtractionStatus @default(PENDING)
  extractionError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
}

// This model represents a group of skills for a job, which can have multiple skill requirements
model SkillGroup {
  id       String @id @default(cuid())
  category String // e.g., "Programming Languages", "Frameworks", "Tools"

  requirementType SkillGroupType @default(ANY) // whether all skill are required (ALL), any one is required (REQUIRED), or none are required but preferred (PREFERRED)

  skills SkillRequirement[] // skills that belong to this group

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// This model represents a skill requirement for a job, which belongs to a skill group
model SkillRequirement {
  id             String @id @default(cuid())
  name           String
  normalizedName String

  groupId String
  group   SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, normalizedName])
  @@index([normalizedName])
}

// This model represents the education requirement for a job
model EducationRequirement {
  id                String          @id @default(cuid())
  minEducationLevel EducationLevel?

  acceptedDegrees       AcceptedDegree[]
  relatedDegreesAllowed Boolean          @default(false) // whether related degrees are allowed or not
  isMandatory           Boolean          @default(true) // whether any of the accepted degrees is mandatory or not

  // Only used if JD has related degrees allowed in specfic field of study
  relatedDegreeFieldsOfStudy           String[] @default([]) // for related degrees
  normalizedRelatedDegreeFieldsOfStudy String[] @default([])

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// This model represents the accepted degree for a job's education requirement
model AcceptedDegree {
  id                   String @id @default(cuid())
  degreeName           String
  normalizedDegreeName String

  acceptedFieldOfStudy           String[] @default([]) // accepted field of study for this degree, if any
  normalizedAcceptedFieldOfStudy String[] @default([])
  isFieldOfStudyMandatory        Boolean  @default(false) // whether any of the accepted field of study is mandatory or not

  educationRequirementId String
  educationRequirement   EducationRequirement @relation(fields: [educationRequirementId], references: [id], onDelete: Cascade)

  @@unique([educationRequirementId, normalizedDegreeName])
  @@index([normalizedDegreeName])
}

model jobResponsibility {
  id             String @id @default(cuid())
  responsibility String // individual responsibility
  weight         Int // weight/importance of this responsibility based on its relevance and importance to the job

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum JobExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SkillGroupType {
  ANY
  ALL
  PREFERRED // this group is preferred but not mandatory, i.e., if the candidate has skills from this group, it will be a plus point, but not having them will not disqualify the candidate
}
